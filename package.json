{
  "name": "reading-helper-auto-scroll",
  "version": "1.0.0",
  "type": "module",
  "description": "Auto Scroll / Reading Helper – for long articles or PDFs. Automatically scrolls webpages with customizable speed and direction.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:extension": "webpack --config webpack.config.cjs --mode production",
    "dev:extension": "webpack --config webpack.config.cjs --mode development --watch",
    "generate-icons": "node generate-icons.js",
    "clean": "rm -rf dist dist-extension"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "postcss": "^8.4.32",
    "postcss-loader": "^7.3.0",
    "style-loader": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "copy-webpack-plugin": "^11.0.0",
    "sharp": "^0.33.0"
  }
}

